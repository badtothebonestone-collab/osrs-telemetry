{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osrs-telemetry.local/schemas/tick.schema.json",
  "title": "OSRS Telemetry Tick",
  "type": "object",
  "required": ["schemaVersion", "tickId", "timestampUtc"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1,
      "description": "Telemetry tick schema version."
    },
    "tickId": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic tick identifier within the session."
    },
    "timestampUtc": {
      "type": "string",
      "minLength": 1,
      "description": "UTC timestamp when the tick snapshot was captured."
    },
    "gameState": { "type": ["string", "null"] },
    "cameraX": { "type": ["integer", "null"], "description": "Read-only RuneLite camera X coordinate." },
    "cameraY": { "type": ["integer", "null"], "description": "Read-only RuneLite camera Y coordinate." },
    "cameraZ": { "type": ["integer", "null"], "description": "Read-only RuneLite camera Z coordinate." },
    "cameraYaw": { "type": ["integer", "null"], "description": "Read-only RuneLite camera yaw." },
    "cameraPitch": { "type": ["integer", "null"], "description": "Read-only RuneLite camera pitch." },
    "viewportWidth": { "type": ["integer", "null"], "minimum": 0, "description": "Read-only game viewport width in canvas pixels." },
    "viewportHeight": { "type": ["integer", "null"], "minimum": 0, "description": "Read-only game viewport height in canvas pixels." },
    "viewportXOffset": { "type": ["integer", "null"], "description": "Read-only game viewport X offset in canvas pixels." },
    "viewportYOffset": { "type": ["integer", "null"], "description": "Read-only game viewport Y offset in canvas pixels." },
    "canvasWidth": { "type": ["integer", "null"], "minimum": 0, "description": "Read-only RuneLite canvas width in pixels." },
    "canvasHeight": { "type": ["integer", "null"], "minimum": 0, "description": "Read-only RuneLite canvas height in pixels." },
    "localPlayer": { "type": ["object", "null"] },
    "inventory": { "type": ["array", "null"] },
    "equipment": { "type": ["array", "null"] },
    "skills": { "type": ["array", "null"] },
    "npcs": {
      "type": ["array", "null"],
      "items": { "$ref": "#/$defs/projectedActorRecord" }
    },
    "players": {
      "type": ["array", "null"],
      "items": { "$ref": "#/$defs/projectedActorRecord" }
    },
    "widgets": { "type": ["array", "null"] },
    "sceneCaptureSummary": {
      "anyOf": [{ "$ref": "#/$defs/sceneCaptureSummary" }, { "type": "null" }],
      "description": "Read-only diagnostic counters describing the bounded scene object scan for this tick."
    },
    "sceneIndexSummary": {
      "anyOf": [{ "$ref": "#/$defs/sceneIndexSummary" }, { "type": "null" }],
      "description": "Optional diagnostic counters for static scene index mode."
    },
    "sceneProjectionSummary": {
      "anyOf": [{ "$ref": "#/$defs/sceneProjectionSummary" }, { "type": "null" }],
      "description": "Optional diagnostic counters for static scene projection refresh/reuse."
    },
    "sceneObjectDeltas": {
      "anyOf": [{ "$ref": "#/$defs/sceneObjectDeltas" }, { "type": "null" }],
      "description": "Optional compact scene object changes emitted by static scene index mode."
    },
    "visibleSceneObjectRefs": {
      "type": ["array", "null"],
      "items": { "$ref": "#/$defs/projectedSceneObjectRecord" },
      "description": "Optional projected scene object refs emitted by static scene index mode."
    },
    "sceneObjects": {
      "type": ["array", "null"],
      "items": { "$ref": "#/$defs/projectedSceneObjectRecord" }
    },
    "groundItems": {
      "type": ["array", "null"],
      "items": { "$ref": "#/$defs/projectedGroundItemRecord" }
    },
    "status": { "type": ["object", "null"] },
    "activePrayers": { "type": ["array", "null"] },
    "framePath": {
      "type": ["string", "null"],
      "description": "Session-relative path associated with the tick's requested frame, for example frames/frame-tick-00000001.jpg. The referenced file may later be deleted by retention."
    },
    "frameCaptureStatus": {
      "type": ["string", "null"],
      "description": "Frame capture/write status. QUEUED means capture/write was requested, not that the file is guaranteed to exist yet.",
      "enum": [
        "QUEUED",
        "WRITTEN",
        "DISABLED",
        "SKIPPED_INTERVAL",
        "DROPPED_QUEUE_FULL",
        "CAPTURE_FAILED",
        null
      ]
    },
    "frameCaptureSource": {
      "type": ["string", "null"],
      "description": "Source used for frame capture.",
      "enum": ["RUNELITE_ONLY", "SCREEN_RECTANGLE", null]
    },
    "frameCaptureWarning": {
      "type": ["string", "null"],
      "description": "Optional warning about frame capture fidelity, such as screen-rectangle overlap risk."
    },
    "captureErrors": {
      "type": ["array", "null"],
      "description": "Capture section names that failed while still allowing the tick record to be written.",
      "items": { "type": "string" }
    },
    "writerQueueSize": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Approximate telemetry record queue size observed when the tick was captured."
    },
    "writerDroppedRecords": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Total telemetry records dropped because the writer queue was full."
    },
    "sceneCaptureDurationMillis": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Approximate elapsed time spent in read-only scene capture for this tick."
    },
    "snapshotBuildDurationMillis": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Approximate elapsed time spent building the tick snapshot before enqueue."
    }
  },
  "$defs": {
    "canvasPoint": {
      "type": "object",
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "bounds": {
      "type": "object",
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "w": { "type": "integer", "minimum": 0 },
        "h": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "polygon": {
      "type": "array",
      "description": "Compact canvas polygon as [x, y] points.",
      "items": {
        "type": "array",
        "minItems": 2,
        "items": { "type": "integer" }
      }
    },
    "projectedActorRecord": {
      "type": "object",
      "description": "NPC/player record. Projection-v1 fields are optional and defensive.",
      "properties": {
        "localX": { "type": ["integer", "null"] },
        "localY": { "type": ["integer", "null"] },
        "npcName": { "type": ["string", "null"] },
        "npcNameSource": { "type": ["string", "null"] },
        "canvasPoint": { "anyOf": [{ "$ref": "#/$defs/canvasPoint" }, { "type": "null" }] },
        "clickboxBounds": { "anyOf": [{ "$ref": "#/$defs/bounds" }, { "type": "null" }] },
        "convexHullBounds": { "anyOf": [{ "$ref": "#/$defs/bounds" }, { "type": "null" }] },
        "onScreen": { "type": ["boolean", "null"] },
        "geometryAvailable": { "type": ["boolean", "null"] },
        "geometryWarning": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "sceneCaptureSummary": {
      "type": "object",
      "description": "Diagnostic-only counters for the bounded, read-only scene scan. Counters explain capture caps without adding object payload.",
      "properties": {
        "sceneCaptureMode": { "type": ["string", "null"] },
        "fullCurrentPlaneScan": { "type": ["boolean", "null"] },
        "configuredRadius": { "type": ["integer", "null"], "minimum": 0 },
        "configuredMaxSceneObjects": { "type": ["integer", "null"], "minimum": 0 },
        "scanRadius": { "type": ["integer", "null"], "minimum": 0 },
        "maxSceneObjects": { "type": ["integer", "null"], "minimum": 0 },
        "maxGroundItems": { "type": ["integer", "null"], "minimum": 0 },
        "scannedPlane": { "type": ["integer", "null"] },
        "scannedTiles": { "type": ["integer", "null"], "minimum": 0 },
        "tilesWithObjects": { "type": ["integer", "null"], "minimum": 0 },
        "scanMinSceneX": { "type": ["integer", "null"] },
        "scanMaxSceneX": { "type": ["integer", "null"] },
        "scanMinSceneY": { "type": ["integer", "null"] },
        "scanMaxSceneY": { "type": ["integer", "null"] },
        "scanWidth": { "type": ["integer", "null"], "minimum": 0 },
        "scanHeight": { "type": ["integer", "null"], "minimum": 0 },
        "sceneObjectsSeen": { "type": ["integer", "null"], "minimum": 0 },
        "sceneObjectsCaptured": { "type": ["integer", "null"], "minimum": 0 },
        "sceneObjectsSkippedByCap": { "type": ["integer", "null"], "minimum": 0 },
        "sceneObjectCapHit": { "type": ["boolean", "null"] },
        "captureRatio": { "type": ["number", "null"], "minimum": 0 },
        "gameObjectsSeen": { "type": ["integer", "null"], "minimum": 0 },
        "wallObjectsSeen": { "type": ["integer", "null"], "minimum": 0 },
        "decorativeObjectsSeen": { "type": ["integer", "null"], "minimum": 0 },
        "groundObjectsSeen": { "type": ["integer", "null"], "minimum": 0 },
        "gameObjectsCaptured": { "type": ["integer", "null"], "minimum": 0 },
        "wallObjectsCaptured": { "type": ["integer", "null"], "minimum": 0 },
        "decorativeObjectsCaptured": { "type": ["integer", "null"], "minimum": 0 },
        "groundObjectsCaptured": { "type": ["integer", "null"], "minimum": 0 },
        "gameObjectsSkippedByCap": { "type": ["integer", "null"], "minimum": 0 },
        "wallObjectsSkippedByCap": { "type": ["integer", "null"], "minimum": 0 },
        "decorativeObjectsSkippedByCap": { "type": ["integer", "null"], "minimum": 0 },
        "groundObjectsSkippedByCap": { "type": ["integer", "null"], "minimum": 0 },
        "nullObjectsSkipped": { "type": ["integer", "null"], "minimum": 0 },
        "groundItemsSeen": { "type": ["integer", "null"], "minimum": 0 },
        "groundItemsCaptured": { "type": ["integer", "null"], "minimum": 0 },
        "groundItemsSkippedByCap": { "type": ["integer", "null"], "minimum": 0 },
        "groundItemCapHit": { "type": ["boolean", "null"] },
        "nullGroundItemsSkipped": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "sceneIndexSummary": {
      "type": "object",
      "description": "Diagnostic-only counters for the optional static scene object index.",
      "properties": {
        "sceneCaptureMode": { "type": ["string", "null"] },
        "indexEnabled": { "type": ["boolean", "null"] },
        "indexObjectCount": { "type": ["integer", "null"], "minimum": 0 },
        "presentObjectCount": { "type": ["integer", "null"], "minimum": 0 },
        "newlyIndexedCount": { "type": ["integer", "null"], "minimum": 0 },
        "updatedCount": { "type": ["integer", "null"], "minimum": 0 },
        "despawnedCount": { "type": ["integer", "null"], "minimum": 0 },
        "fullResyncThisTick": { "type": ["boolean", "null"] },
        "resyncReason": { "type": ["string", "null"] },
        "indexCapHit": { "type": ["boolean", "null"] },
        "maxSceneIndexObjects": { "type": ["integer", "null"], "minimum": 0 },
        "sceneIndexBuildDurationMillis": { "type": ["integer", "null"], "minimum": 0 },
        "sceneIndexUpdateDurationMillis": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "sceneProjectionSummary": {
      "type": "object",
      "description": "Diagnostic-only counters for projection refresh/reuse in static scene index mode.",
      "properties": {
        "projectionStateHash": { "type": ["string", "null"] },
        "projectionStateChanged": { "type": ["boolean", "null"] },
        "projectionRefreshMode": { "type": ["string", "null"] },
        "projectionCandidatesConsidered": { "type": ["integer", "null"], "minimum": 0 },
        "projectionObjectsUpdated": { "type": ["integer", "null"], "minimum": 0 },
        "projectionObjectsReused": { "type": ["integer", "null"], "minimum": 0 },
        "projectionDurationMillis": { "type": ["integer", "null"], "minimum": 0 },
        "visibleObjectCount": { "type": ["integer", "null"], "minimum": 0 },
        "onScreenObjectCount": { "type": ["integer", "null"], "minimum": 0 },
        "geometryAvailableCount": { "type": ["integer", "null"], "minimum": 0 },
        "missingGeometryCount": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "sceneObjectDeltas": {
      "type": "object",
      "description": "Compact scene object changes from static scene index mode.",
      "properties": {
        "newObjects": { "type": ["array", "null"], "items": { "$ref": "#/$defs/projectedSceneObjectRecord" } },
        "updatedObjects": { "type": ["array", "null"], "items": { "$ref": "#/$defs/projectedSceneObjectRecord" } },
        "despawnedObjects": { "type": ["array", "null"], "items": { "$ref": "#/$defs/projectedSceneObjectRecord" } }
      },
      "additionalProperties": true
    },
    "projectedSceneObjectRecord": {
      "type": "object",
      "description": "Scene object record. Projection fields are optional and defensive.",
      "properties": {
        "objectKey": { "type": ["string", "null"] },
        "hash": { "type": ["integer", "number", "string", "null"] },
        "kind": { "type": ["string", "null"] },
        "actions": { "type": ["array", "null"], "items": { "type": ["string", "null"] } },
        "firstSeenTick": { "type": ["integer", "null"], "minimum": 0 },
        "lastSeenTick": { "type": ["integer", "null"], "minimum": 0 },
        "lastUpdatedTick": { "type": ["integer", "null"], "minimum": 0 },
        "present": { "type": ["boolean", "null"] },
        "despawnedTick": { "type": ["integer", "null"], "minimum": 0 },
        "source": { "type": ["string", "null"] },
        "projectionVersion": { "type": ["integer", "null"], "minimum": 0 },
        "localX": { "type": ["integer", "null"] },
        "localY": { "type": ["integer", "null"] },
        "objectName": { "type": ["string", "null"] },
        "objectNameSource": { "type": ["string", "null"] },
        "canvasLocation": { "anyOf": [{ "$ref": "#/$defs/canvasPoint" }, { "type": "null" }] },
        "canvasTilePolygon": { "anyOf": [{ "$ref": "#/$defs/polygon" }, { "type": "null" }] },
        "clickboxBounds": { "anyOf": [{ "$ref": "#/$defs/bounds" }, { "type": "null" }] },
        "clickboxPolygon": { "anyOf": [{ "$ref": "#/$defs/polygon" }, { "type": "null" }] },
        "convexHullBounds": { "anyOf": [{ "$ref": "#/$defs/bounds" }, { "type": "null" }] },
        "convexHullPolygon": { "anyOf": [{ "$ref": "#/$defs/polygon" }, { "type": "null" }] },
        "onScreen": { "type": ["boolean", "null"] },
        "geometryAvailable": { "type": ["boolean", "null"] },
        "geometryWarning": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "projectedGroundItemRecord": {
      "type": "object",
      "description": "Ground item record. Projection fields describe the item's tile and are optional.",
      "properties": {
        "localX": { "type": ["integer", "null"] },
        "localY": { "type": ["integer", "null"] },
        "itemName": { "type": ["string", "null"] },
        "itemNameSource": { "type": ["string", "null"] },
        "canvasTilePolygon": { "anyOf": [{ "$ref": "#/$defs/polygon" }, { "type": "null" }] },
        "canvasCenter": { "anyOf": [{ "$ref": "#/$defs/canvasPoint" }, { "type": "null" }] },
        "onScreen": { "type": ["boolean", "null"] },
        "geometryAvailable": { "type": ["boolean", "null"] },
        "geometryWarning": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
