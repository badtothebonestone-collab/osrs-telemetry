{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osrs-telemetry.local/schemas/tick.schema.json",
  "title": "OSRS Telemetry Tick",
  "type": "object",
  "required": ["schemaVersion", "tickId", "timestampUtc"],
  "properties": {
    "schemaVersion": { "type": "string", "minLength": 1 },
    "tickId": { "type": "integer", "minimum": 0 },
    "timestampUtc": { "type": "string", "minLength": 1 },
    "gameState": { "type": ["string", "null"] },
    "localPlayer": { "type": ["object", "null"] },
    "inventory": { "type": ["array", "null"] },
    "equipment": { "type": ["array", "null"] },
    "skills": { "type": ["array", "null"] },
    "npcs": { "type": ["array", "null"] },
    "players": { "type": ["array", "null"] },
    "widgets": { "type": ["array", "null"] },
    "sceneObjects": { "type": ["array", "null"] },
    "groundItems": { "type": ["array", "null"] },
    "status": { "type": ["object", "null"] },
    "activePrayers": { "type": ["array", "null"] },
    "captureErrors": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "writerQueueSize": { "type": ["integer", "null"], "minimum": 0 },
    "writerDroppedRecords": { "type": ["integer", "null"], "minimum": 0 }
  },
  "additionalProperties": true
}
