{
  "daemon_url": "http://127.0.0.1:8890",
  "snapshot_url": "http://127.0.0.1:8893",
  "backend": "arduino",
  "arduino_port": "COM6",
  "runelite_launch_command": ".\\gradlew.bat run",
  "trace_output_path": "interaction_geometry/live/navigation_decisions.jsonl",
  "auto_login_enabled": true,
  "auto_login_command": [
    "{python}",
    "{viewer_dir}\\context_service.py",
    "--ensure-loaded-scene",
    "--daemon-url",
    "{daemon_url}",
    "--snapshot-url",
    "{snapshot_url}",
    "--arduino-port",
    "{arduino_port}",
    "--liveness-max-total-seconds",
    "{timeout_seconds}"
  ],
  "auto_login_timeout_seconds": 120,
  "auto_login_max_attempts": 1,
  "auto_login_working_directory": "{project_root}",
  "max_actions": 1,
  "max_runtime_seconds": 30,
  "wait_for_ready_seconds": 10,
  "max_wait_seconds": 300,
  "watch_poll_seconds": 5
}
