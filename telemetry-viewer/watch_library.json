{
  "schema": "watch_library.v1",
  "limits": {
    "maxTotalWatches": 32,
    "maxWatchedVarbits": 16,
    "maxWatchedVarps": 16,
    "maxWatchedVarclients": 8,
    "maxWatchedWidgets": 4,
    "maxWatchedContainers": 4,
    "watchDefaultTtlTicks": 500,
    "watchMaxTtlTicks": 5000,
    "watchMaxValuesPerTick": 32,
    "watchBudgetMillis": 2.0
  },
  "watches": [
    {
      "alias": "inventory_summary",
      "type": "builtin",
      "id": "inventory.summary",
      "description": "Inventory free/filled slots, full status, signature, and total quantity.",
      "taskProfiles": ["woodcutting", "inventory_qa"],
      "enabledByDefault": true,
      "sampleMode": "on_change",
      "intervalTicks": 0,
      "ttlTicks": 0,
      "maxEmitPerTick": 1,
      "normalLiveAllowed": true,
      "debugAuditOnly": false
    },
    {
      "alias": "equipment_summary",
      "type": "builtin",
      "id": "equipment.summary",
      "description": "Equipment signature and bounded summary when present in compact inventory packets.",
      "taskProfiles": ["all"],
      "enabledByDefault": true,
      "sampleMode": "on_change",
      "intervalTicks": 0,
      "ttlTicks": 0,
      "maxEmitPerTick": 1,
      "normalLiveAllowed": true,
      "debugAuditOnly": false
    },
    {
      "alias": "run_energy",
      "type": "builtin",
      "id": "baseline.run_energy",
      "description": "Run energy observation when available in baseline/status telemetry.",
      "taskProfiles": ["navigation_qa", "woodcutting"],
      "enabledByDefault": true,
      "sampleMode": "every_tick",
      "intervalTicks": 1,
      "ttlTicks": 0,
      "maxEmitPerTick": 1,
      "normalLiveAllowed": true,
      "debugAuditOnly": false
    },
    {
      "alias": "activity_animation",
      "type": "builtin",
      "id": "activity.animation",
      "description": "Current animation, pose animation, apparent activity state, and interaction summary.",
      "taskProfiles": ["woodcutting"],
      "enabledByDefault": true,
      "sampleMode": "on_change",
      "intervalTicks": 0,
      "ttlTicks": 0,
      "maxEmitPerTick": 1,
      "normalLiveAllowed": true,
      "debugAuditOnly": false
    },
    {
      "alias": "example_state",
      "type": "builtin",
      "id": "inventory.summary",
      "description": "Disabled example watch used by docs/tests; aliases the builtin inventory summary.",
      "taskProfiles": ["example"],
      "enabledByDefault": false,
      "sampleMode": "on_change",
      "intervalTicks": 0,
      "ttlTicks": 500,
      "maxEmitPerTick": 1,
      "normalLiveAllowed": true,
      "debugAuditOnly": false
    },
    {
      "alias": "example_varbit_disabled",
      "type": "varbit",
      "id": 0,
      "description": "Placeholder disabled varbit watch; replace with a known safe id before enabling.",
      "taskProfiles": ["example"],
      "enabledByDefault": false,
      "sampleMode": "on_change",
      "intervalTicks": 0,
      "ttlTicks": 500,
      "maxEmitPerTick": 1,
      "normalLiveAllowed": false,
      "debugAuditOnly": true
    }
  ]
}
